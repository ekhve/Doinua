diff --git a/crates/fm1-soc/src/lib.rs b/crates/fm1-soc/src/lib.rs
index 9c4cc00..ec6bdf4 100644
--- a/crates/fm1-soc/src/lib.rs
+++ b/crates/fm1-soc/src/lib.rs
@@ -896,7 +896,14 @@ impl Soc {
 
     fn sfr_get(&mut self, addr: u32) -> u32 {
         if addr < SFR_LO_END && addr & 3 == 0 {
-            return self.sfr_lo[(addr >> 2) as usize];
+            let v = self.sfr_lo[(addr >> 2) as usize];
+            // the audio PLL (PLL0) as M-VAVE's bootloader leaves it on every FM-1, until a firmware writes it
+            // (felucca-bsp fm1_audio.h FM1_AUDIO_PLL_STOCK0/1: fm1_audio_init_checked starts on nothing else)
+            return match addr {
+                0x119A0 if v == 0 => 0x4540_0203,
+                0x119A4 if v == 0 => 0x3F50_3026,
+                _ => v,
+            };
         }
         *self.sfr.get(&addr).unwrap_or(&0)
     }
